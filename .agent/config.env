# Dark Factory Task Operations Configuration Template
# Copy this file to .agent/config.env or set these environment variables in your shell.

# GitHub Organization or User owning the Project v2 board (e.g. Mindstar-Studio)
GH_PROJECT_OWNER="Mindstar-Studio"

# GitHub Project Number (e.g. 2 for https://github.com/orgs/Mindstar-Studio/projects/2)
GH_PROJECT_NUMBER="2"

# GitHub Project ID
GH_PROJECT_ID="PVT_kwDODvOeL84BhyN8"

# Base directory where git worktrees should be placed
# If left commented, defaults to $(dirname "$PROJECT_ROOT")/worktrees/${REPO_NAME:-dark-city}
# or $PROJECT_ROOT/.worktrees
WORKTREES_DIR="/home/brian/dev/ai/worktrees/dark-city"

# Default base branch to branch off (default: main)
DEFAULT_BASE_BRANCH="main"
